# First transport. Later: app | telegram,app — plugin id stays `fulanto.oncall`.
TRANSPORT=telegram

# Telegram bot token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Numeric chat id. Message the bot once, then read getUpdates.
# Only this chat receives pings. Other chats are ignored because we never poll.
TELEGRAM_CHAT_ID=

# Statuses to ping, comma-separated. v1 default is blocked only.
# Official example also fired on done; keep that off until the path is proven.
NOTIFY_ON=blocked

# Optional. 0 / false / no / off = start disabled until you toggle on.
HERDR_TELEGRAM_ENABLED=1

# Drop a second ping for the same pane+status within this window (ms).
DEBOUNCE_MS=2000

# Optional. Toggle sets the host terminal title while notifications are on.
HERDR_TELEGRAM_SET_TITLE=1
HERDR_TELEGRAM_TITLE=oncall
