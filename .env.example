# First channel. Later: app | telegram,app — plugin id stays `com.codreamer.herdr.oncall`.
CHANNEL=telegram

# Telegram bot token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Numeric chat id. Leave empty and run:
#   herdr plugin action invoke pair --plugin com.codreamer.herdr.oncall
# then open the printed t.me link. Only this chat is allowed.
TELEGRAM_CHAT_ID=

# Statuses to ping, comma-separated. Default is blocked and done.
NOTIFY_ON=blocked,done

# Optional. 0 / false / no / off = start disabled until you toggle on.
HERDR_TELEGRAM_ENABLED=1

# Drop a second ping for the same pane+status within this window (ms).
DEBOUNCE_MS=2000

# Seconds to wait after blocked before pinging. 0 = send immediately.
# After the wait, skip if that pane is no longer blocked (you already answered).
BLOCKED_DELAY_SEC=60

# Optional. Toggle sets the host terminal title while notifications are on.
HERDR_TELEGRAM_SET_TITLE=1
HERDR_TELEGRAM_TITLE=oncall

# Optional. 0 = do not long-poll Telegram for replies.
TELEGRAM_POLL=1

# Optional. 0 = do not force a reply box on pings.
TELEGRAM_FORCE_REPLY=1

# Optional, macOS only. A floating panel in the top-right corner with one button
# per blocked option and a text field. Blocked: the panel replaces the
# BLOCKED_DELAY_SEC wait; answer there and Telegram is skipped. 0 = off.
DESKTOP_PANEL=1

# Seconds the panel stays open. Empty = BLOCKED_DELAY_SEC (60 if that is 0).
DESKTOP_PANEL_TIMEOUT_SEC=

# The panel is skipped (or closed) while you are looking at the pane: it is
# Herdr's focused pane and a terminal app is frontmost. Common terminals are
# recognised by bundle id; add yours here, comma-separated, if it is not.
DESKTOP_PANEL_TERMINALS=

# Optional. 1 = log the screen and window rect the panel was placed on, to the
# plugin log. Use when the panel shows up in the wrong corner.
DESKTOP_PANEL_DEBUG=
