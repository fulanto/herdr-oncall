# Where pings go when the desk does not answer: telegram, feishu, or both
# (telegram,feishu). Pairing Feishu sets this to feishu. Replies are taken from
# every paired channel either way. Plugin id stays `com.codreamer.herdr.oncall`.
CHANNEL=telegram

# Telegram bot token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Numeric chat id. Leave empty and run:
#   herdr plugin action invoke pair --plugin com.codreamer.herdr.oncall
# then open the printed t.me link. Only this chat is allowed.
TELEGRAM_CHAT_ID=

# Feishu (Lark). Leave all four empty and run:
#   herdr plugin action invoke pair-feishu --plugin com.codreamer.herdr.oncall
# then scan the QR code with the Feishu app. The scan creates your bot and
# writes these. Only FEISHU_OPEN_ID (whoever scanned) may drive panes.
# Pairing survives reinstalls; every scan creates a new bot, so pair-feishu on
# a paired machine only says so. To pair a new bot, unpair first:
#   herdr plugin action invoke unpair-feishu --plugin com.codreamer.herdr.oncall
# Receiving replies needs Node 22 or later.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OPEN_ID=
# feishu or lark
FEISHU_DOMAIN=

# Done pings carry the agent's own last answer, read from its session record.
# Claude Code needs nothing for that. Codex needs Herdr's Codex integration to
# tell which session a pane runs, and Oncall installs it at startup when
# ~/.codex exists. 0 = never touch agent configs; those done pings are then
# read off the screen.
INSTALL_AGENT_INTEGRATION=1

# Releases install themselves: every few hours Oncall asks Herdr to update it
# from the `stable` branch, which only moves when a version is released, and
# says so on the paired chats when it did. A checkout linked for development
# is never updated. 0 = update only by hand (herdr plugin update).
AUTO_UPDATE=1

# Statuses to ping, comma-separated. Default is blocked and done.
NOTIFY_ON=blocked,done

# Optional. 0 / false / no / off = start disabled until you toggle on.
HERDR_TELEGRAM_ENABLED=1

# Drop a second ping for the same pane+status within this window (ms).
DEBOUNCE_MS=2000

# Seconds to wait after blocked before pinging. 0 = send immediately.
# After the wait, skip if that pane is no longer blocked (you already answered).
BLOCKED_DELAY_SEC=60

# Optional. Toggle sets the host terminal title while notifications are on.
HERDR_TELEGRAM_SET_TITLE=1
HERDR_TELEGRAM_TITLE=oncall

# Optional. 0 = do not long-poll Telegram for replies.
TELEGRAM_POLL=1

# Optional. 0 = do not force a reply box on pings.
TELEGRAM_FORCE_REPLY=1

# Optional, macOS only. A floating panel in the top-right corner with one button
# per blocked option and a text field. Blocked: the panel replaces the
# BLOCKED_DELAY_SEC wait; answer there and Telegram is skipped. 0 = off.
DESKTOP_PANEL=1

# Seconds the panel stays open. Empty = BLOCKED_DELAY_SEC (60 if that is 0).
DESKTOP_PANEL_TIMEOUT_SEC=

# The panel is skipped (or closed) while you are looking at the pane: it is
# Herdr's focused pane and a terminal app is frontmost. Common terminals are
# recognised by bundle id; add yours here, comma-separated, if it is not.
DESKTOP_PANEL_TERMINALS=

# Optional. 1 = log the screen and window rect the panel was placed on, to the
# plugin log. Use when the panel shows up in the wrong corner.
DESKTOP_PANEL_DEBUG=

# With drover. drover's installer writes these to drover.env beside this file,
# and that file is read last: a value set here wins over drover's, an empty one
# does not count. They are left commented out on purpose; uncomment one only to
# override drover. Without drover, none of this applies.
#
# The main session's agent name in Herdr. Empty = no roles: every pane is
# handled as without drover.
#   MAIN_AGENT_NAME=drover
# Agents named with this prefix are orchestrators; any other named agent is a
# worker. Their done is not pinged (the layer above relays it), and their
# dialog is pinged only if the same one is still waiting after:
#   SUPERVISOR_PREFIX=orch-
#   SUPERVISOR_ESCALATE_SEC=300
#   SUPERVISOR_ESCALATE_SEC_CODEX=120   (when the main session runs Codex)
#   SUPERVISED_ESCALATE_SEC=600         (a worker)
# Where a chat message that quotes no ping goes: last = the pane of the latest
# ping, main = the main session (prefixed [飞书] / [Telegram]).
#   BARE_MESSAGE_TARGET=main
# What the main session's done sends: always = every turn; relay = only the
# answer to a chat message (as a reply to it), a turn whose closing answer
# starts with the relay marker, and an API error notice.
#   MAIN_DONE_PING=relay
#   MAIN_RELAY_MARKER=【转达】
